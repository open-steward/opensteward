<% const canAct = user && (user.role === 'admin' || user.role === 'operator') %>
<%
  // `null` means the route deliberately did not fetch the list (a viewer, whom
  // admin-api forbids from reading it). That is a different fact from an empty
  // list, and must not render as "no tokens" — see routes/customers.ts.
  const tokensUnavailable = typeof mcpTokens !== 'undefined' && mcpTokens === null
  const tokens = mcpTokens || []
  const minted = mintedPlaintext || null

  // The deployment's public URL, trailing slash trimmed. `null` when
  // company-info has no baseUrl set (or was unreachable) — rendered as an
  // explicit "set this first" below rather than a placeholder host, because a
  // snippet that looks complete and points nowhere costs the customer a
  // support round-trip to discover.
  const rawBaseUrl = typeof mcpBaseUrl !== 'undefined' ? mcpBaseUrl : null
  const mcpUrl = rawBaseUrl ? String(rawBaseUrl).replace(/\/+$/, '') : null

  // Built as data, not a heredoc, so the copy button and the rendered block
  // cannot drift. Key and package match apps/mcp-server/README.md; the
  // end-user token selects per-customer mode, where the agent sees only this
  // customer's connections.
  const claudeConfig = minted
    ? JSON.stringify(
        {
          mcpServers: {
            OpenSteward: {
              command: 'npx',
              args: ['-y', '@opensteward/mcp-server'],
              env: {
                OPENSTEWARD_BASE_URL: mcpUrl || 'SET_YOUR_PUBLIC_BASE_URL',
                OPENSTEWARD_USER_TOKEN: minted,
              },
            },
          },
        },
        null,
        2,
      )
    : ''
%>

<style>
  /* Scoped to the minted-token panel. The config is the thing an operator
     actually hands over, so it gets a real code-block treatment rather than a
     bare <pre> wedged inside the alert. */
  .mcp-snippet { margin-top: var(--space-3); border-top: 1px solid var(--border-subtle); padding-top: var(--space-3); }
  .mcp-snippet > summary {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-2);
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .mcp-snippet > summary::-webkit-details-marker { display: none; }
  .mcp-snippet > summary::before {
    content: '▸';
    font-size: 10px;
    color: var(--fg-3);
    transition: transform 120ms ease;
  }
  .mcp-snippet[open] > summary::before { transform: rotate(90deg); }
  .mcp-snippet > summary:hover { color: var(--fg-1); }
  .mcp-snippet__body { margin-top: var(--space-3); display: grid; gap: var(--space-3); }
  .mcp-snippet__step { margin: 0; font-size: var(--text-xs); color: var(--fg-2); line-height: 1.5; }
  .mcp-snippet__step code {
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--surface-2);
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    overflow-wrap: anywhere;
  }
  /* One path per line with its OS beside it. Inline, these two long paths wrap
     mid-filename and read as one run-on string. */
  .mcp-snippet__paths {
    display: grid;
    grid-template-columns: auto max-content;
    gap: 4px var(--space-2);
    align-items: baseline;
    margin-top: 6px;
  }
  .mcp-snippet__paths .muted { font-size: 10px; text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .mcp-code {
    position: relative;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .mcp-code__copy { position: absolute; top: var(--space-2); right: var(--space-2); z-index: 1; }
  .mcp-code > pre {
    margin: 0;
    padding: var(--space-3);
    padding-right: 72px; /* clear of the copy button */
    font-size: var(--text-xs);
    line-height: 1.6;
    overflow-x: auto;
  }
</style>
<section class="card" style="padding: var(--space-5) var(--space-6); margin-top: var(--space-6)">
  <h2 style="margin: 0 0 var(--space-2); font-size: var(--text-lg)">MCP tokens</h2>
  <p class="muted" style="margin: 0 0 var(--space-4); font-size: var(--text-sm)">
    Per-customer read-only tokens for AI agents (Claude Desktop, Cursor, Continue, Cline,
    gemini-cli). Hand the plaintext to the customer to paste into their agent's MCP
    config — they will see only their own connections. Revoke any time.
  </p>

  <% if (minted) { %>
    <div class="alert alert--success" style="margin-bottom: var(--space-4)">
      <%#
        `.alert` is `display: flex` in row direction — it is built for
        [icon][text], so every block child of it becomes its own column.
        Everything here goes in ONE flex child instead, and that child takes
        `min-width: 0` so the code blocks inside it may shrink and scroll
        rather than forcing the alert wider than its card.
      -%>
      <div style="flex: 1; min-width: 0">
      <p style="margin: 0 0 var(--space-2)"><strong>Token minted.</strong> Copy it now — it cannot be retrieved later.</p>
      <div class="mcp-code" style="margin: var(--space-2) 0">
        <button type="button" class="btn btn--sm btn--ghost mcp-code__copy"
                data-copy="<%= minted %>">Copy</button>
        <pre class="mono" style="word-break: break-all"><%= minted %></pre>
      </div>
      <details class="mcp-snippet">
        <summary>Claude Desktop config</summary>
        <div class="mcp-snippet__body">
          <p class="mcp-snippet__step">
            <strong>1.</strong> Open Claude Desktop's config file:
            <span class="mcp-snippet__paths">
              <code>~/Library/Application Support/Claude/claude_desktop_config.json</code>
              <span class="muted">macOS</span>
              <code>%APPDATA%\Claude\claude_desktop_config.json</code>
              <span class="muted">Windows</span>
            </span>
          </p>

          <% if (!mcpUrl) { %>
            <p class="mcp-snippet__step" style="color: var(--warning-fg)">
              <strong>No public base URL is set for this deployment</strong>, so the snippet below
              carries a placeholder the customer must replace. Set it under
              <a href="/company-info">Company info → Base URL</a> and mint again to get a
              ready-to-paste config.
            </p>
          <% } %>

          <p class="mcp-snippet__step"><strong>2.</strong> Add this block, merging with any
            <code>mcpServers</code> already there:</p>

          <div class="mcp-code">
            <button type="button" class="btn btn--sm btn--ghost mcp-code__copy"
                    data-copy="<%= claudeConfig %>">Copy</button>
            <pre class="mono"><%= claudeConfig %></pre>
          </div>

          <p class="mcp-snippet__step">
            <strong>3.</strong> Restart Claude Desktop. The OpenSteward tools appear in the tool
            picker, scoped to this customer's connections only.
          </p>
        </div>
      </details>
      </div>
    </div>
  <% } %>

  <% if (canAct) { %><form method="POST" action="/customers/<%= customer.id %>/mcp-tokens" style="display: flex; gap: var(--space-2); margin-bottom: var(--space-4); align-items: end; flex-wrap: wrap">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="flex: 1; min-width: 220px">
      <span class="field__label" style="display: block; font-size: var(--text-xs); color: var(--fg-3); margin-bottom: 4px">Label (optional)</span>
      <input type="text" name="label" placeholder="e.g. Claude Desktop on Laptop" class="input" style="width: 100%">
    </label>
    <button type="submit" class="btn btn--primary">Mint new token</button>
  </form><% } %>

  <% if (tokensUnavailable) { %>
    <p class="muted" style="font-size: var(--text-sm); margin: 0">Listing this customer's MCP tokens needs the operator role. This is not a claim that there are none.</p>
  <% } else if (tokens.length === 0) { %>
    <p class="muted" style="font-size: var(--text-sm); margin: 0">No active tokens for this customer.</p>
  <% } else { %>
    <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm)">
      <thead>
        <tr style="text-align: left; color: var(--fg-3); border-bottom: 1px solid var(--border-subtle)">
          <th style="padding: var(--space-2)">Label</th>
          <th style="padding: var(--space-2)">Prefix</th>
          <th style="padding: var(--space-2)">Created</th>
          <th style="padding: var(--space-2)">Last used</th>
          <th style="padding: var(--space-2)">Status</th>
          <th style="padding: var(--space-2)"></th>
        </tr>
      </thead>
      <tbody>
        <% for (const t of tokens) { %>
          <tr style="border-bottom: 1px solid var(--border-subtle)">
            <td style="padding: var(--space-3) var(--space-2)"><%= t.label || '—' %></td>
            <td class="mono" style="padding: var(--space-3) var(--space-2); font-size: var(--text-xs)"><%= t.prefix %>…</td>
            <td class="muted" style="padding: var(--space-3) var(--space-2); font-size: var(--text-xs)"><%= new Date(t.createdAt).toLocaleDateString() %></td>
            <td class="muted" style="padding: var(--space-3) var(--space-2); font-size: var(--text-xs)">
              <%= t.lastUsedAt ? new Date(t.lastUsedAt).toLocaleString() : '—' %>
            </td>
            <td style="padding: var(--space-3) var(--space-2)">
              <% if (t.revokedAt) { %>
                <span class="badge badge--muted">revoked</span>
              <% } else { %>
                <span class="badge badge--ok">active</span>
              <% } %>
            </td>
            <td style="padding: var(--space-3) var(--space-2); text-align: right">
              <% if (!t.revokedAt) { %>
                <% if (canAct) { %><form method="POST" action="/customers/<%= customer.id %>/mcp-tokens/<%= t.id %>/revoke" style="display: inline" onsubmit="return confirm('Revoke this token? The customer\'s agent will lose access immediately.')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn--sm btn--ghost">Revoke</button>
                </form><% } %>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</section>
