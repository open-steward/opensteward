<%
  // OAuth credentials form for a platform. Used by the wizard's step 5 and
  // the standalone /platforms/:vertical/:slug detail page. Caller passes:
  //   vertical, slug          — for the form's hidden inputs and headings
  //   derivedRedirectUri      — pre-built /auth/{vertical}/{slug}/callback URL
  //   company                 — companyInfo record (or null) for the sidebar
  //   prefill                 — { clientId, redirectUri, scopes, hasSecret,
  //                               sandbox, supportsSandbox,
  //                               recommendedScopes } or null. When set,
  //                             clientSecret stays blank with a "leave empty
  //                             to keep current" hint.
  //   scopeGroups             — operator-defined scope bundles for this
  //                             (vertical, platform). Optional; defaults to [].
  const pf = (typeof prefill !== 'undefined' && prefill) ? prefill : null
  const clientIdValue = pf?.clientId ?? ''
  const redirectUriValue = pf?.redirectUri ?? derivedRedirectUri
  const hasSecret = !!pf?.hasSecret
  const supportsSandbox = pf?.supportsSandbox === true
  const sandboxOn = pf?.sandbox === true
  const groups = (typeof scopeGroups !== 'undefined' && Array.isArray(scopeGroups)) ? scopeGroups : []
  const recommended = Array.isArray(pf?.recommendedScopes) ? pf.recommendedScopes : []
  const readScopes = Array.isArray(pf?.readScopes) ? pf.readScopes : []
  // supportsScopeOverride defaults to true; false means scopes are fixed at the
  // OAuth-app level and anything set here is ignored by the provider.
  const supportsOverride = pf ? pf.supportsScopeOverride !== false : true
  const savedScopes = Array.isArray(pf?.scopes) ? pf.scopes : []
  const recommendedSet = new Set(recommended)
  const readSet = new Set(readScopes)
  const savedSet = new Set(savedScopes)
  // Free-text bucket = saved scopes that aren't in the recommended catalog.
  const customScopes = savedScopes.filter((s) => !recommendedSet.has(s))
  const customScopesValue = customScopes.join(', ')
  function escAttr(s) { return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') }
%>
<div class="grid" style="grid-template-columns: 2fr 1fr; gap: var(--space-6); align-items: start">
  <div class="card stack">
    <%
      // Cross-link to the per-platform integration guide on docs-server.
      // The guide lives on a different origin than the admin (in dev:
      // :3003 vs :3000), so prefix with the configured docs-server URL.
      // docsServerUrl is injected into reply.locals at boot — see
      // apps/admin/src/core/server.ts.
      //
      // Only 80 of 1,545 platforms have a guide, so the card must be gated on
      // hasIntegrationGuide or every other platform — Fortnox included —
      // offers a walkthrough that 404s. `hasIntegrationGuide` is the same
      // `has_guide` flag the public Browse cards gate their Guide link on.
      const docsBase = (typeof docsServerUrl !== 'undefined' && docsServerUrl) ? docsServerUrl : ''
      const guideHref = docsBase + '/guides/integrate/' + vertical + '/' + slug + '.md'
      // Absent helper hides the card: never offer a link we cannot confirm.
      const showGuide = typeof hasIntegrationGuide === 'function'
        ? hasIntegrationGuide(vertical, slug)
        : false
    %>
    <% if (showGuide) { %>
    <a href="<%= guideHref %>" target="_blank" rel="noopener" class="callout-link" style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-1); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); text-decoration: none; color: inherit; margin-bottom: var(--space-2)">
      <i class="ph ph-book-open" aria-hidden="true" style="font-size: 18px; color: var(--fg-2)"></i>
      <div style="flex: 1">
        <strong style="display: block">Integration guide</strong>
        <span class="muted" style="font-size: var(--text-sm)">Walk through the <%= slug %> dev-portal setup step by step.</span>
      </div>
      <i class="ph ph-arrow-up-right" aria-hidden="true" style="color: var(--fg-3)"></i>
    </a>
    <% } %>
    <div class="field">
      <label class="field__label" for="clientId">Client ID</label>
      <input class="input" type="text" name="clientId" id="clientId" value="<%= clientIdValue %>" placeholder="e.g. my-app-id">
    </div>

    <div class="field">
      <label class="field__label" for="clientSecret">Client secret</label>
      <input class="input" type="password" name="clientSecret" id="clientSecret" placeholder="<%= hasSecret ? '•••••••• (saved)' : 'e.g. sk_live_…' %>">
      <% if (hasSecret) { %>
      <span class="field__hint">Stored encrypted. Leave empty to keep current; type a new value to overwrite.</span>
      <% } else { %>
      <span class="field__hint">Stored encrypted with AES-256-GCM.</span>
      <% } %>
    </div>

    <div class="field">
      <label class="field__label" for="redirectUri">Redirect URI</label>
      <input class="input input--mono" type="text" name="redirectUri" id="redirectUri" value="<%= redirectUriValue %>">
      <% if (company && company.baseUrl) { %>
      <span class="field__hint">Auto-derived from your company base URL.</span>
      <% } %>
    </div>

    <% if (supportsSandbox) { %>
    <div class="field">
      <label class="field__label" for="sandbox">Environment</label>
      <%# An unticked checkbox posts nothing, and the backend MERGES config —
          so without this companion hidden field, unticking could set the flag
          but never clear it. The parser keys off `sandboxPresent`. %>
      <input type="hidden" name="sandboxPresent" value="1">
      <label class="checkbox">
        <input type="checkbox" name="sandbox" id="sandbox" value="true" <%= sandboxOn ? 'checked' : '' %>>
        <span>Use the platform's sandbox / staging environment</span>
      </label>
      <span class="field__hint">
        An OAuth app exists in <strong>one</strong> environment only. Picking the wrong one is rejected
        at the authorization step by the provider's own error page, which usually does not say why —
        it looks identical to a bad redirect URI. Tick this if the app was created in the sandbox.
      </span>
    </div>
    <% } %>

    <div class="stack" data-scope-picker>
      <div class="field__label" style="margin-bottom: 0">Scopes</div>
      <span class="field__hint">
        These are this adapter's <strong>default</strong> scopes (the “platform default”), used for every connection unless a Connect Link picks read-only or a scope group. Links minted in this console use these scopes by default; links created through the developer API default to <strong>read-only</strong>.
      </span>

      <!-- Platform-specific read-only guidance, driven by the curated metadata. -->
      <% if (!supportsOverride) { %>
      <div class="alert alert--warning" style="margin: 0">
        <i class="ph ph-lock" aria-hidden="true"></i>
        <div><strong><%= slug %></strong> fixes its OAuth scopes at the app-registration level — scopes set here (and per-link overrides) are ignored. Choose read-only access in the <strong><%= slug %></strong> developer portal when you register the app.
      </div>
      </div>
      <% } else if (readScopes.length > 0) { %>
      <div class="alert alert--success" style="margin: 0; align-items: flex-start">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        <div style="flex: 1">
          <strong>Read-only is available for <%= slug %>.</strong>
          <div class="muted" style="font-size: var(--text-sm); margin: var(--space-1) 0 var(--space-2)">
            <%= readScopes.length %> read-only scope<%= readScopes.length === 1 ? '' : 's' %>: <span class="mono"><%= readScopes.join(', ') %></span>
          </div>
          <button type="button" class="btn btn--secondary btn--sm" data-read-only-apply
            data-read-scopes='<%= escAttr(JSON.stringify(readScopes)) %>'>Use read-only scopes</button>
          <span class="field__hint" style="margin-top: var(--space-2)">Ticks exactly the read-only scopes and clears the rest. Developer-API links use these by default, and console links use them when you choose Read-only — set them here too if you want every connection read-only.</span>
        </div>
      </div>
      <% } else if (recommended.length > 0) { %>
      <div class="alert alert--info" style="margin: 0">
        <i class="ph ph-info" aria-hidden="true"></i>
        <div>No dedicated read-only scope set is catalogued for <strong><%= slug %></strong> — its scopes may combine read and write. Pick only the scopes you need below; check <%= slug %>'s OAuth docs for read-only options (often suffixed <span class="mono">.read</span> or <span class="mono">read_*</span>).</div>
      </div>
      <% } %>

      <% if (groups.length > 0) { %>
      <div>
        <div class="muted" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2)">Custom groups</div>
        <div class="stack stack--sm">
          <% for (const g of groups) { %>
          <label class="row" style="gap: var(--space-2); align-items: flex-start; cursor: pointer">
            <input type="checkbox" data-scope-group='<%= escAttr(JSON.stringify(g.scopes)) %>'>
            <div>
              <div><%= g.name %> <span class="mono muted">(<%= g.scopes.length %> scope<%= g.scopes.length === 1 ? '' : 's' %>)</span></div>
              <div class="muted" style="font-size: var(--text-xs)"><%= g.scopes.join(', ') %></div>
            </div>
          </label>
          <% } %>
        </div>
      </div>
      <% } %>

      <% if (recommended.length > 0) { %>
      <div>
        <div class="muted" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2)">Standard scopes</div>
        <div class="stack stack--sm">
          <% for (const scope of recommended) { %>
          <label class="row" style="gap: var(--space-2); align-items: center; cursor: pointer">
            <input type="checkbox" name="scopes" value="<%= escAttr(scope) %>" data-scope-checkbox <%= savedSet.has(scope) ? 'checked' : '' %>>
            <span class="mono"><%= scope %></span>
            <% if (readSet.has(scope)) { %><span class="badge badge--success" style="font-size: var(--text-2xs)">read-only</span><% } %>
          </label>
          <% } %>
        </div>
      </div>
      <% } %>

      <div class="field">
        <label class="field__label" for="scopesCustom">Custom scopes</label>
        <input class="input" type="text" name="scopesCustom" id="scopesCustom" value="<%= customScopesValue %>" placeholder="comma- or space-separated">
        <span class="field__hint">For scopes not in the standard list above. Merged with checked options on save.</span>
      </div>

      <% if (groups.length === 0 && recommended.length === 0) { %>
      <span class="field__hint">No scope catalogue for <strong><%= slug %></strong> yet — so read-only can't be pre-filled. Enter read scopes from <%= slug %>'s OAuth docs (commonly suffixed <span class="mono">.read</span> or prefixed <span class="mono">read_</span>), or define a <a href="/scope-groups/new?vertical=<%= vertical %>&platform=<%= slug %>">custom scope group</a>.</span>
      <% } %>
    </div>
  </div>

  <%- include('_dev-portal-sidebar', { slug: slug, company: company, derivedRedirectUri: derivedRedirectUri }) %>
</div>

<script>
  // Wire group checkboxes: ticking a group ticks every checkbox-mode scope in
  // its scope list and appends any non-standard scopes to the free-text field.
  // Unticking the group does NOT auto-unselect — operators may want to keep
  // individual scopes after deselecting the bundle.
  (function () {
    var picker = document.querySelector('[data-scope-picker]')
    if (!picker) return
    var freeText = picker.querySelector('input[name="scopesCustom"]')

    // "Use read-only scopes": set the config to EXACTLY the platform's curated
    // read-only scopes — tick matching standard boxes, untick the rest, and put
    // any read scope not in the standard list into the free-text field.
    var readBtn = picker.querySelector('[data-read-only-apply]')
    if (readBtn) {
      readBtn.addEventListener('click', function () {
        var readScopes
        try { readScopes = JSON.parse(readBtn.getAttribute('data-read-scopes') || '[]') } catch (_) { return }
        var readSet = new Set(readScopes)
        var standardCbs = Array.from(picker.querySelectorAll('input[data-scope-checkbox]'))
        var standardValues = new Set(standardCbs.map(function (cb) { return cb.value }))
        standardCbs.forEach(function (cb) { cb.checked = readSet.has(cb.value) })
        if (freeText) {
          freeText.value = readScopes.filter(function (s) { return !standardValues.has(s) }).join(', ')
        }
      })
    }
    picker.querySelectorAll('input[data-scope-group]').forEach(function (groupCb) {
      groupCb.addEventListener('change', function () {
        if (!groupCb.checked) return
        var scopes
        try { scopes = JSON.parse(groupCb.getAttribute('data-scope-group') || '[]') } catch (_) { return }
        var standardCbs = Array.from(picker.querySelectorAll('input[data-scope-checkbox]'))
        var standardValues = new Set(standardCbs.map(function (cb) { return cb.value }))
        var freeAdds = []
        scopes.forEach(function (s) {
          if (standardValues.has(s)) {
            standardCbs.forEach(function (cb) { if (cb.value === s) cb.checked = true })
          } else {
            freeAdds.push(s)
          }
        })
        if (freeAdds.length && freeText) {
          var existing = freeText.value.split(/[\s,]+/).filter(Boolean)
          var merged = Array.from(new Set(existing.concat(freeAdds)))
          freeText.value = merged.join(', ')
        }
        // Reset the group checkbox so it acts as a one-shot "apply" button.
        groupCb.checked = false
      })
    })
  })()
</script>
