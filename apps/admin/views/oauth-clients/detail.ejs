<% layout('../layout', { title: issuer.name }) -%>
<%
  const isAdmin = user && user.role === 'admin'
  const fmtDate = (v) => v ? new Date(v).toLocaleString() : '—'
  const mode = issuer.authorityMode
  const usesRegistry = mode !== 'external'
  const SCOPE_GROUPS = [
    { eyebrow: 'Customers', items: [
      { value: 'customers:read', label: 'Read' },
      { value: 'customers:write', label: 'Write' },
      { value: 'customers:read_pii', label: 'Reveal PII' },
    ]},
    { eyebrow: 'Connect links & connections', items: [
      { value: 'connect-links:write', label: 'Create connect link' },
      { value: 'connections:read', label: 'Read connections' },
      { value: 'connections:write', label: 'Write connections' },
    ]},
    { eyebrow: 'Verticals — touch axis', items: [
      ...knownVerticals.map(v => ({ value: 'vertical:' + v.name, label: v.label })),
      { value: 'vertical:read', label: 'Read all verticals' },
    ]},
    { eyebrow: 'Verticals — verb axis', items: [
      { value: 'vertical:write', label: 'Write to verticals' },
    ]},
  ]
  const safeSet = new Set(safeDefaultScopes || [])
%>

<header class="page-header">
  <div class="page-header__group">
    <div class="page-header__eyebrow"><a href="/oauth-clients">OAuth clients</a></div>
    <h1 class="page-header__title"><%= issuer.name %></h1>
    <p class="page-header__desc mono" style="font-size: var(--text-sm)"><%= issuer.issuer %></p>
  </div>
</header>

<div class="card" style="margin-top: var(--space-6)">
  <div class="kv-list kv-list--compact">
    <div class="kv-list__row"><span class="kv-list__key">Audience</span><span class="kv-list__value mono"><%= issuer.audience %></span></div>
    <div class="kv-list__row"><span class="kv-list__key">JWKS</span><span class="kv-list__value mono" style="word-break: break-all"><%= issuer.jwksUri %></span></div>
    <div class="kv-list__row"><span class="kv-list__key">Subject claim</span><span class="kv-list__value mono"><%= issuer.subjectClaim %></span></div>
    <div class="kv-list__row"><span class="kv-list__key">Scope claim</span><span class="kv-list__value mono"><%= issuer.scopeClaim %></span></div>
    <div class="kv-list__row"><span class="kv-list__key">Algorithms</span><span class="kv-list__value mono"><%= issuer.algorithms.join(', ') %></span></div>
    <div class="kv-list__row">
      <span class="kv-list__key">Last verified</span>
      <span class="kv-list__value">
        <% if (issuer.lastVerifiedAt) { %><%= fmtDate(issuer.lastVerifiedAt) %><% } else { %>
        <span class="badge badge--warning">Never</span>
        <span class="muted" style="font-size: var(--text-xs)">— present a real token before relying on this</span>
        <% } %>
      </span>
    </div>
  </div>
</div>

<% if (mode === 'external') { %>
<div class="alert alert--warning" style="margin-top: var(--space-6)">
  <div class="stack stack--sm">
    <div><strong>This issuer's tokens carry their own authority.</strong></div>
    <div class="muted" style="font-size: var(--text-sm)">
      There is no service account to delete, so a leaked token stays valid until it expires
      (at most <span class="mono"><%= issuer.maxTokenLifetimeS %>s</span> here). The only immediate kill
      switch is unticking "Accept tokens" below.
    </div>
  </div>
</div>
<% } %>

<% if (isAdmin) { %>
<div class="card" style="margin-top: var(--space-6)">
  <h2 class="card__title" style="margin-top: 0">Settings</h2>
  <form method="POST" action="/oauth-clients/<%= issuer.id %>" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">
      <span class="field__label">Name</span>
      <input type="text" name="name" value="<%= issuer.name %>" required>
    </label>
    <label class="field">
      <span class="field__label">Audience</span>
      <input type="text" name="audience" value="<%= issuer.audience %>" required>
      <span class="field__hint">Changing this clears the "last verified" marker — it was proof about a different configuration.</span>
    </label>
    <div class="row" style="gap: var(--space-3)">
      <label class="field" style="flex: 1">
        <span class="field__label">Subject claim</span>
        <input type="text" name="subjectClaim" value="<%= issuer.subjectClaim %>" required>
      </label>
      <label class="field" style="flex: 1">
        <span class="field__label">Scope claim</span>
        <input type="text" name="scopeClaim" value="<%= issuer.scopeClaim %>" required>
      </label>
    </div>
    <label class="field">
      <span class="field__label">Authority</span>
      <select name="authorityMode">
        <option value="registry" <%= mode === 'registry' ? 'selected' : '' %>>Registry — service accounts below decide</option>
        <option value="intersect" <%= mode === 'intersect' ? 'selected' : '' %>>Registry, narrowed by the token</option>
        <option value="external" <%= mode === 'external' ? 'selected' : '' %>>The token decides — no revocation before expiry</option>
      </select>
    </label>
    <label class="field">
      <span class="field__label">Tenant claim <span class="muted">(token-decides mode only)</span></span>
      <input type="text" name="tenantClaim" value="<%= issuer.tenantClaim || '' %>">
    </label>
    <label class="field">
      <span class="field__label">Allowed tenants <span class="muted">(one per line; empty admits nobody)</span></span>
      <textarea name="allowedTenants" rows="3"><%= (issuer.allowedTenants || []).join('\n') %></textarea>
    </label>
    <label class="field">
      <span class="field__label">Maximum token lifetime (seconds)</span>
      <input type="number" name="maxTokenLifetimeS" value="<%= issuer.maxTokenLifetimeS %>" min="1">
    </label>
    <label class="row" style="gap: var(--space-2); align-items: center; cursor: pointer">
      <input type="checkbox" name="enabled" <%= issuer.enabled ? 'checked' : '' %>>
      <span>Accept tokens from this issuer</span>
    </label>
    <div class="row" style="gap: var(--space-3)">
      <button type="submit" class="btn btn--primary">Save</button>
    </div>
  </form>
</div>
<% } %>

<% if (usesRegistry) { %>
<div class="card" style="margin-top: var(--space-6)">
  <div class="card__header">
    <h2 class="card__title">Service accounts (<%= clients.filter(c => !c.revokedAt).length %>)</h2>
  </div>
  <% if (clients.length === 0) { %>
  <p class="muted" style="margin: 0">
    None registered. Until one is, every token from this issuer is refused — the subject has nothing to match.
  </p>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>Subject</th><th>Tenant</th><th>Scopes</th><th>Last used</th><% if (isAdmin) { %><th></th><% } %></tr>
      </thead>
      <tbody>
        <% for (const c of clients) { %>
        <tr<%= c.revokedAt ? ' style="opacity: 0.55"' : '' %>>
          <td>
            <span class="mono"><%= c.subject %></span>
            <% if (c.label) { %><div class="muted" style="font-size: var(--text-xs)"><%= c.label %></div><% } %>
          </td>
          <td class="mono"><%= c.tenantId %></td>
          <td class="muted" style="font-size: var(--text-xs)"><%= c.scopes.join(', ') %></td>
          <td class="muted" style="font-size: var(--text-xs)"><%= fmtDate(c.lastUsedAt) %></td>
          <% if (isAdmin) { %>
          <td style="text-align: right">
            <% if (c.revokedAt) { %>
            <span class="badge badge--danger">Revoked</span>
            <% } else { %>
            <form method="POST" action="/oauth-clients/clients/<%= c.id %>/revoke" onsubmit="return confirm('Revoke this service account? Any token it holds stops working on the next call.')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="issuerId" value="<%= issuer.id %>">
              <input type="hidden" name="subject" value="<%= c.subject %>">
              <button type="submit" class="btn btn--danger btn--sm">Revoke</button>
            </form>
            <% } %>
          </td>
          <% } %>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if (isAdmin) { %>
  <form method="POST" action="/oauth-clients/<%= issuer.id %>/clients" class="stack" style="margin-top: var(--space-5); border-top: 1px solid var(--border-subtle); padding-top: var(--space-5)">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row" style="gap: var(--space-3)">
      <label class="field" style="flex: 1">
        <span class="field__label">Subject</span>
        <input type="text" name="subject" placeholder="billing-service" required>
        <span class="field__hint">The value of <span class="mono"><%= issuer.subjectClaim %></span> in their tokens.</span>
      </label>
      <%# A <select>, as on /webhooks/new and /api-keys/new: the tenant a
          service account acts for is exactly what a token from this subject
          may reach, so a mistyped id here scopes the account to a tenant that
          does not exist and every call it makes is refused. The select lists
          every registered tenant. The typeable fallback survives an admin-api
          outage — `tenants` comes from listTenants(...).catch(() => []), and
          an empty list is an outage, never a deployment with no tenants. %>
      <% const tenantChoices = (typeof tenants !== 'undefined' && tenants) || [] %>
      <label class="field" style="flex: 1">
        <span class="field__label">Tenant</span>
        <% if (tenantChoices.length > 0) { %>
        <select class="select" name="tenantId" required>
          <% for (const t of tenantChoices) { %>
          <option value="<%= t.id %>"<%= t.id === 'default' ? ' selected' : '' %>><%= t.name %> (<%= t.id %>)</option>
          <% } %>
        </select>
        <span class="field__hint">What a token from this subject may reach. Register more at <a href="/tenants">/tenants</a>.</span>
        <% } else { %>
        <input class="input mono" type="text" name="tenantId" value="default" required autocomplete="off">
        <span class="field__hint">The tenant list could not be loaded, so this could not be filled in for you — check the id before saving.</span>
        <% } %>
      </label>
      <label class="field" style="flex: 1">
        <span class="field__label">Label</span>
        <input type="text" name="label" placeholder="Billing service">
      </label>
    </div>
    <div class="stack">
      <% for (const group of SCOPE_GROUPS) { %>
      <div>
        <div class="muted" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); margin-bottom: var(--space-2)"><%= group.eyebrow %></div>
        <div class="row" style="flex-wrap: wrap; gap: var(--space-3)">
          <% for (const item of group.items) { %>
          <label class="row" style="gap: var(--space-2); align-items: center; cursor: pointer">
            <input type="checkbox" name="scopes" value="<%= item.value %>" <%= safeSet.has(item.value) ? 'checked' : '' %>>
            <span style="font-size: var(--text-sm)"><%= item.label %></span>
          </label>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <div><button type="submit" class="btn btn--primary btn--sm">Register service account</button></div>
  </form>
  <% } %>
</div>
<% } %>

<div class="card" style="margin-top: var(--space-6)">
  <div class="card__header">
    <h2 class="card__title">Scope mapping (<%= rules.length %>)</h2>
  </div>
  <p class="muted" style="margin: 0 0 var(--space-3); font-size: var(--text-sm)">
    <% if (rules.length === 0) { %>
    No rules, so the token's <span class="mono"><%= issuer.scopeClaim %></span> claim passes through verbatim —
    which is what you want if your IdP already emits OpenSteward scope names. Add a rule and only mapped values
    survive; anything unmapped is dropped rather than passed through raw.
    <% } else { %>
    Only these values are honoured now. Anything else in the token's
    <span class="mono"><%= issuer.scopeClaim %></span> claim is dropped.
    <% } %>
  </p>
  <% if (rules.length > 0) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Token value</th><th>Grants</th><% if (isAdmin) { %><th></th><% } %></tr></thead>
      <tbody>
        <% for (const r of rules) { %>
        <tr>
          <td class="mono"><%= r.claimValue %></td>
          <td class="mono"><%= r.grantedScope %></td>
          <% if (isAdmin) { %>
          <td style="text-align: right">
            <form method="POST" action="/oauth-clients/rules/<%= r.id %>/delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="issuerId" value="<%= issuer.id %>">
              <button type="submit" class="btn btn--secondary btn--sm">Remove</button>
            </form>
          </td>
          <% } %>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
  <% if (isAdmin) { %>
  <form method="POST" action="/oauth-clients/<%= issuer.id %>/rules" class="row" style="gap: var(--space-3); align-items: flex-end; margin-top: var(--space-4)">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field" style="flex: 1">
      <span class="field__label">Token value</span>
      <input type="text" name="claimValue" placeholder="read:ledger" required>
    </label>
    <label class="field" style="flex: 1">
      <span class="field__label">Grants scope</span>
      <input type="text" name="grantedScope" placeholder="vertical:accounting" required>
    </label>
    <button type="submit" class="btn btn--secondary">Add rule</button>
  </form>
  <% } %>
</div>

<% if (isAdmin) { %>
<div class="card" style="margin-top: var(--space-6); border-color: var(--danger-border)">
  <h2 class="card__title" style="margin-top: 0">Delete issuer</h2>
  <p class="muted" style="margin: 0 0 var(--space-3); font-size: var(--text-sm)">
    Removes it along with its service accounts and rules. Tokens from it stop being accepted at once.
  </p>
  <form method="POST" action="/oauth-clients/<%= issuer.id %>/delete" onsubmit="return confirm('Delete this issuer and everything registered under it?')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn--danger btn--sm">Delete</button>
  </form>
</div>
<% } %>
