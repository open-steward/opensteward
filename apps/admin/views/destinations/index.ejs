<% layout('../layout', { title: 'Destinations' }) -%>
<%
  const statusBadge = { success: 'badge--success', failed: 'badge--danger', running: 'badge--info' }
-%>
<header class="page-header">
  <div class="page-header__group">
    <div class="page-header__eyebrow">Admin</div>
    <h1 class="page-header__title">Destinations</h1>
    <p class="page-header__desc">
      Scheduled exports of the synced records to storage you own: Parquet files in S3, Google Cloud
      Storage or Azure Blob, or rows in a Postgres database. Personal data is masked unless a
      destination was approved to export it. You see the destinations inside your tenant scope.
    </p>
  </div>
  <% if (!disabled) { %>
  <div class="page-header__actions">
    <a href="/destinations/new" class="btn btn--primary btn--sm">New destination</a>
  </div>
  <% } %>
</header>

<% if (disabled) { %>
<div class="card" style="margin-top: var(--space-6)">
  <div class="empty-state">
    <div class="empty-state__icon"><i class="ph ph-database"></i></div>
    <h3 class="empty-state__title">Nothing is stored to export</h3>
    <p class="empty-state__body">This deployment runs with <code class="mono">DATA_STORE_MODE=passthrough</code>: records are fetched on demand and never kept, so there is nothing for a destination to export.</p>
  </div>
</div>
<% } else if (destinations.length === 0) { %>
<div class="card" style="margin-top: var(--space-6)">
  <div class="empty-state" data-destinations-empty>
    <div class="empty-state__icon"><i class="ph ph-export"></i></div>
    <h3 class="empty-state__title">No destinations yet</h3>
    <p class="empty-state__body">Add one to copy synced records to your lake or warehouse on a schedule.</p>
    <div class="empty-state__actions"><a class="btn btn--primary" href="/destinations/new">New destination</a></div>
  </div>
</div>
<% } else { %>
<div class="card" style="margin-top: var(--space-6); padding: 0">
  <div class="table-scroll">
  <table class="table" data-destinations>
    <thead>
      <tr><th scope="col">Destination</th><th scope="col">Scope</th><th scope="col">Schedule</th><th scope="col">Last run</th></tr>
    </thead>
    <tbody>
      <% for (const d of destinations) { %>
      <tr>
        <td>
          <a href="/destinations/<%= encodeURIComponent(d.id) %>"><strong><%= d.name %></strong></a>
          <div class="muted" style="font-size: var(--text-xs)"><%= d.typeLabel %></div>
          <% if (d.includePii) { %><span class="badge badge--warning">exports PII</span><% } %>
        </td>
        <td style="font-size: var(--text-sm)"><%= d.scopeText %></td>
        <td>
          <% if (d.enabled) { %><%= d.intervalText %><% } else { %><span class="badge">disabled</span><% } %>
        </td>
        <td>
          <% if (!d.lastStatus) { %>
          <span class="muted">never</span>
          <% } else { %>
          <span class="badge <%= statusBadge[d.lastStatus] || '' %>"><%= d.lastStatus %></span>
          <span class="muted" style="font-size: var(--text-xs)"><%= d.lastRunAt ? new Date(d.lastRunAt).toLocaleString() : '' %></span>
          <% if (d.lastError) { %><div class="muted" style="font-size: var(--text-xs)" title="<%= d.lastError %>"><%= d.lastError.length > 80 ? d.lastError.slice(0, 79) + '…' : d.lastError %></div><% } %>
          <% } %>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
<% } %>
