{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declarationMap": false,
    "sourceMap": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo-app"
  },
  "include": [
    "src/*.ts",
    "src/sandbox/**/*",
    "src/data-access/**/*",
    "src/analytics/**/*",
    "src/workers/**/*",
    "src/webhooks/**/*",
    "src/types/**/*",
    "src/licensing/**/*"
