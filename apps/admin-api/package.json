{
  "name": "admin-api",
  "version": "1.0.0",
  "description": "Headless JSON REST API for OpenSteward admin operations",
  "license": "Elastic-2.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db-copy": "tsx src/db-copy.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-admin-openapi.ts",
    "generate:postman": "tsx scripts/generate-postman.ts",
    "generate:runtime-settings-schema": "tsx scripts/generate-runtime-settings-schema.ts",
    "superset:bootstrap": "tsx src/scripts/superset-bootstrap.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-saml/node-saml": "^5.2.0",
    "@opensteward/codegen": "workspace:*",
    "@opensteward/shared": "workspace:*",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.1.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-zod-openapi": "^5.7.0",
    "js-yaml": "^5.5.0",
    "ldapts": "^9.2.0",
    "openid-client": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^26.6.6",
    "jose": "^6.2.17",
    "ldapjs": "^3.0.7",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0",
    "xml-crypto": "^6.4.0"
  },
  "author": {
    "name": "Falco Consulting AB"
  },
  "maintainers": [
    {
      "name": "Falco Consulting AB",
      "url": "https://opensteward.dev"
    }
  ]
}
