# Copy to terraform.tfvars and edit. Only project_id is required; everything
# else has a lean default (see variables.tf). NEVER put real secrets here —
# app secrets and the DB password are generated by Terraform.

project_id = "my-gcp-project"
region     = "us-central1"

# Must match how you run `helm install <release> ...`.
# KSA the chart creates = "<helm_release_name>-opensteward".
helm_release_name = "os"
namespace         = "opensteward"

# Lean cluster footprint — scale up for prod.
node_machine_type = "e2-standard-4"
node_min_count    = 1
node_max_count    = 3

# Cloud SQL. Set db_availability_type = "REGIONAL" for HA.
use_private_ip = true

# Provision Memorystore for redis.url (off by default).
enable_memorystore = false
