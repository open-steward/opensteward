# Cloud SQL for PostgreSQL.
#
# Private IP is preferred (reachable in-cluster over the VPC peering created in
# network.tf, no proxy). If use_private_ip = false the instance is created with a
# Cloud SQL connection name only and you reach it via the Cloud SQL Auth Proxy
# sidecar — see README "Auth Proxy alternative".
#
# PASSWORD HANDLING: the DB password is generated by the random provider and only
# ever lives in Terraform state and the DATABASE_URL output (marked sensitive).
# It is NOT written to Secret Manager by this stack — the operator pastes the
# DATABASE_URL into the `opensteward-db` Kubernetes secret (or syncs it via ESO).

resource "random_password" "db" {
  length  = 32
  special = false # keep the URL clean / avoid percent-encoding surprises
}

resource "google_sql_database_instance" "this" {
  name             = "${var.name_prefix}-pg"
  database_version = var.db_version
  region           = var.region

  deletion_protection = var.db_deletion_protection

  settings {
    tier              = var.db_tier
    availability_type = var.db_availability_type
    disk_size         = var.db_disk_size_gb
    disk_autoresize   = true
    user_labels       = var.labels

    ip_configuration {
      # No public IP when we have private IP; ipv4_enabled stays true only as the
      # fallback when private IP is disabled (then reach it via the Auth Proxy).
      ipv4_enabled    = var.use_private_ip ? false : true
      private_network = var.use_private_ip ? google_compute_network.vpc.id : null
      # No authorized_networks: never expose the instance to the public internet.
    }

    backup_configuration {
      enabled = true
    }
  }

  # The private IP can't be assigned until the VPC peering exists.
  depends_on = [
    google_service_networking_connection.private_vpc_connection,
    google_project_service.enabled,
  ]
}

resource "google_sql_database" "app" {
  name     = var.db_name
  instance = google_sql_database_instance.this.name
}

resource "google_sql_user" "app" {
  name     = var.db_user
  instance = google_sql_database_instance.this.name
  password = random_password.db.result
}
