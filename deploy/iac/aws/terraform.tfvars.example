# Copy to terraform.tfvars and adjust. All values have sensible defaults in
# variables.tf — this just shows the knobs you most often change.

region      = "us-east-1"
name_prefix = "opensteward"
environment = "prod"

# --- Must match `helm install <release> --namespace <namespace>` ---
# IRSA trust binds to system:serviceaccount:<k8s_namespace>:<release>-opensteward.
helm_release_name = "os"
k8s_namespace     = "opensteward"

# --- EKS ---
kubernetes_version  = "1.33"
node_instance_types = ["m6i.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 5

# --- RDS ---
db_instance_class      = "db.t4g.medium"
db_multi_az            = false # set true for production HA
db_deletion_protection = false # set true for production
