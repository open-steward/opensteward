# RDS for PostgreSQL + a security group that only the EKS nodes can reach.
#
# Password handling: generated by the random provider and stored in Secrets
# Manager (see secrets.tf, aws_secretsmanager_secret.db). It is NOT written to
# the DB-engine attributes in a way that lands in plaintext outputs — the
# DATABASE_URL output is marked sensitive. For production prefer
# manage_master_user_password=true (RDS-managed rotation) and have ESO sync the
# RDS-managed secret instead of the static one here.

# Allow Postgres (5432) from the EKS node security group only.
resource "aws_security_group" "rds" {
  name        = "${var.name_prefix}-rds"
  description = "OpenSteward RDS PostgreSQL — ingress from EKS nodes only"
  vpc_id      = module.vpc.vpc_id

  tags = merge(local.tags, { Name = "${var.name_prefix}-rds" })
}

resource "aws_security_group_rule" "rds_from_nodes" {
  type                     = "ingress"
  description              = "PostgreSQL from EKS worker nodes"
  from_port                = 5432
  to_port                  = 5432
  protocol                 = "tcp"
  security_group_id        = aws_security_group.rds.id
  source_security_group_id = module.eks.node_security_group_id
}

module "rds" {
  source  = "terraform-aws-modules/rds/aws"
  version = "~> 6.9"

  identifier = "${var.name_prefix}-pg"

  engine               = "postgres"
  engine_version       = var.db_engine_version
  family               = "postgres${split(".", var.db_engine_version)[0]}"
  major_engine_version = split(".", var.db_engine_version)[0]
  instance_class       = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  port     = 5432

  # Use the random-generated password (secrets.tf); do not let the module
  # manage/rotate it, so the value stays consistent with the DATABASE_URL we
  # emit and the K8s secret the operator creates.
  manage_master_user_password = false
  password                    = random_password.db.result

  multi_az               = var.db_multi_az
  db_subnet_group_name   = module.vpc.database_subnet_group_name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false

  backup_retention_period = var.db_backup_retention_days
  deletion_protection     = var.db_deletion_protection
  skip_final_snapshot     = !var.db_deletion_protection
  apply_immediately       = true

  performance_insights_enabled = true

  tags = local.tags
}
