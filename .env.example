# OpenSteward .env.example
#
# Generated by `tsx scripts/generate-env-example.ts`. Lists every env var
# the codebase reads. Copy to `.env` (gitignored) and fill in values.
#
# `pnpm doctor` diffs your `.env` against this file: missing requireds
# fail the doctor, missing optionals warn.

# ── Required ───────────────────────────────────────────────────────
# These MUST be set in production. assertSecret() rejects placeholders,
# short values, and low-entropy strings — see packages/shared/src/auth/secrets.ts.

# JWT_SECRET — REQUIRED
#   HMAC key for admin-api JWTs. At least 32 random chars.
#   read by: apps/admin-api/src/config.ts
JWT_SECRET=

# SESSION_SECRET — REQUIRED
#   Cookie session-store secret used by admin. At least 32 random chars.
#   read by: apps/admin/src/config.ts
SESSION_SECRET=

# STORE_SECRET — REQUIRED
#   AES-256-GCM key for encrypted-at-rest blobs (OAuth tokens, PII, SSO secrets).
#   At least 32 random chars.
#   read by: apps/admin-api/src/config.ts, apps/integration-server/src/config.ts, packages/shared/src/scripts/doctor.ts
STORE_SECRET=

# ── Optional ───────────────────────────────────────────────────────
# Either has a sane runtime default or is feature-gated. Doctor warns
# if any are unset; the runtime continues.

# ADMIN_API_URL — optional
#   In-network URL of admin-api (used by other services for host-info lookups).
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts, apps/admin/scripts/screenshots/seed.ts, apps/admin/src/config.ts, apps/admin/src/core/version-info.ts (+5 more)
ADMIN_API_URL=

# ADMIN_PASS — optional
#   Dev script only — older name for ADMIN_USER_PASSWORD, still accepted by the
#   screenshot automation.
#   read by: apps/admin/scripts/screenshots/seed.ts
ADMIN_PASS=

# ADMIN_SECRET — optional
#   Optional. Bearer token gating the control-plane admin endpoints. May be unset
#   in dev.
#   read by: apps/admin-api/src/core/server.ts, apps/admin-api/src/scripts/superset-bootstrap.ts, apps/integration-server/src/config.ts, apps/integration-server/src/server.ts (+2 more)
ADMIN_SECRET=

# ADMIN_UI_URL — optional
#   Browser-facing URL of the admin app. Where the post-SSO handoff lands.
#   read by: apps/admin-api/src/config.ts, apps/admin-api/src/scripts/superset-bootstrap.ts
ADMIN_UI_URL=

# ADMIN_URL — optional
#   Dev script only — base URL of the admin app for screenshot automation.
#   read by: apps/admin/scripts/screenshots/run.ts
ADMIN_URL=

# ADMIN_USER — optional
#   Dev script only — admin username the screenshot automation (`pnpm
#   docs:screenshots`) signs in with.
#   read by: apps/admin/scripts/screenshots/seed.ts
ADMIN_USER=

# ADMIN_USER_PASSWORD — optional
#   Dev script only — password for ADMIN_USER in the screenshot automation.
#   read by: apps/admin/scripts/screenshots/seed.ts
ADMIN_USER_PASSWORD=

# ANALYTICS_ADMIN_DATABASE_URL — optional
#   Optional, Postgres only. A postgres:// URL for a role with CREATEROLE that
#   owns (or may GRANT on) the store tables. When set, integration-server
#   provisions the read-only SQL views (re-provisioning on boot when the view
#   catalog changed) and creates, rotates and revokes SQL principals itself. Unset
#   = manual mode: it only generates the SQL for an operator to run. See
#   docs/deployment/postgres-analytics.md.
#   read by: apps/integration-server/src/config.ts
ANALYTICS_ADMIN_DATABASE_URL=

# ANALYTICS_READ_HOST — optional
#   Optional. The host BI tools should connect to for read-only SQL access (e.g. a
#   read replica), shown with each new SQL principal. Unset = the admin UI shows
#   no host.
#   read by: apps/integration-server/src/config.ts
ANALYTICS_READ_HOST=

# ANALYTICS_ROLE_PREFIX — optional
#   Optional. Prefix for every Postgres role read-only SQL access creates
#   (<prefix>_analytics_owner, <prefix>_sql_<name>_<id>, …). Roles are
#   cluster-global, so deployments sharing a Postgres cluster need different
#   prefixes. Lowercase, starts with a letter, at most 16 chars. Default os.
#   read by: apps/integration-server/src/config.ts
ANALYTICS_ROLE_PREFIX=

# APPFOLIO_DATABASE — optional
#   Appfolio adapter — tenant database identifier.
#   read by: apps/integration-server/src/verticals/accounting/adapters/appfolio/index.ts
APPFOLIO_DATABASE=

# AUTH_DEV_API_KEYS_ENABLED — optional
#   Set "0" to refuse osk_ developer keys on /v1/*. Only the boot-time default —
#   the admin UI setting auth.dev_api_keys_enabled overrides it and is read per
#   request. Does not affect X-Admin-Secret.
#   read by: apps/integration-server/src/server.ts
AUTH_DEV_API_KEYS_ENABLED=

# AUTH_DEV_OAUTH_ENABLED — optional
#   Set "1" to accept OIDC bearer tokens on /v1/* from issuers registered under
#   Admin -> OAuth clients. Only the boot-time default; auth.dev_oauth_enabled
#   overrides it. Lets an infrastructure-as-code deployment start with OAuth on
#   before anyone opens the admin UI.
#   read by: apps/integration-server/src/server.ts
AUTH_DEV_OAUTH_ENABLED=

# BILLIT_SANDBOX — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/verticals/accounting/adapters/billit/constants.ts
BILLIT_SANDBOX=

# BOOTSTRAP_TOKEN — optional
#   Gates first-run admin creation: POST /api/auth/setup requires it as
#   X-Bootstrap-Token. Set this before the first `docker compose up` in any
#   deployment reachable by anyone else — while it is unset and no admin exists
#   yet, whoever posts a username and password first becomes the admin. Ignored
#   once setup has completed (the endpoint returns 409).
#   read by: apps/admin-api/src/config.ts
BOOTSTRAP_TOKEN=

# BRANDFETCH_API_KEY — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: packages/codegen/src/fetch-logos.ts
BRANDFETCH_API_KEY=

# BRANDFETCH_CLIENT_ID — optional
#   Optional. Brandfetch client ID, needed for LOGO_SOURCE=cdn and by `pnpm
#   --filter integration-server fetch:logos` to populate LOGO_SOURCE=local. Free
#   at https://brandfetch.com/developers. Not a secret — Brandfetch designed it to
#   be embedded in public <img> tags.
#   read by: apps/admin/src/core/routes/logo-config.ts, apps/admin/src/core/routes/platforms.ts, apps/admin/src/core/routes/wizard.ts, packages/codegen/src/fetch-logos.ts (+1 more)
BRANDFETCH_CLIENT_ID=

# BRANDFETCH_REFERER — optional
#   Optional. Referer header sent on Brandfetch CDN requests by the logo-fetch
#   script. Should match the origin registered for your Brandfetch app.
#   read by: packages/codegen/src/fetch-logos.ts
BRANDFETCH_REFERER=

# BUILD_TIME — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: packages/shared/src/control-plane/version-router.ts
BUILD_TIME=

# COMPOSE_PROJECT_NAME — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: packages/shared/src/scripts/backup.ts
COMPOSE_PROJECT_NAME=

# CONFIG_PATH — optional
#   Override path to config.yml. Defaults to ./config/config.yml relative to cwd.
#   read by: apps/admin-api/src/config.ts, apps/admin/src/config.ts, apps/integration-server/scripts/generate-openapi.ts, apps/integration-server/src/config.ts (+2 more)
CONFIG_PATH=

# CORS_ORIGIN — optional
#   Comma-separated origins allowed to call the API from a browser. Empty
#   (default) sends no CORS headers. Required for docs-server's Swagger "Try it
#   out", which is cross-origin.
#   read by: apps/integration-server/src/config.ts
CORS_ORIGIN=

# DATABASE_URL — optional
#   Optional. postgres:// URL selecting the Postgres backend for the stateful
#   services (unset = SQLite). Read-only SQL access and embedded Superset need it.
#   superset-bootstrap also reads its host and database as the default target for
#   Superset's connection.
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
DATABASE_URL=

# DATA_STORE_AUTO_SYNC_ON_BOOT — optional
#   Cold-start warm-up: enqueue one sync job per active connection at boot.
#   read by: apps/integration-server/src/config.ts
DATA_STORE_AUTO_SYNC_ON_BOOT=

# DATA_STORE_EXTERNAL_BATCH_EVENTS — optional
#   When true, sync emits one event per page instead of one per resource (external
#   mode).
#   read by: apps/integration-server/src/config.ts
DATA_STORE_EXTERNAL_BATCH_EVENTS=

# DATA_STORE_MAX_SIZE_MB — optional
#   Soft size budget (MB) for resources.db. WARN at this value, ERROR at 10x.
#   read by: apps/integration-server/src/config.ts
DATA_STORE_MAX_SIZE_MB=

# DATA_STORE_MODE — optional
#   database | passthrough | external. Default database.
#   read by: apps/integration-server/src/config.ts
DATA_STORE_MODE=

# DATA_STORE_PATH — optional
#   SQLite file for the resource cache.
#   read by: apps/integration-server/src/config.ts
DATA_STORE_PATH=

# DATA_STORE_STALE_AFTER_SECONDS — optional
#   TTL for cached rows. Unset = manual invalidation only.
#   read by: apps/integration-server/src/config.ts
DATA_STORE_STALE_AFTER_SECONDS=

# DATA_STORE_SYNC_PAGE_SIZE — optional
#   Upstream pagination size for sync jobs. Default 500.
#   read by: apps/integration-server/src/config.ts
DATA_STORE_SYNC_PAGE_SIZE=

# DESTINATIONS_ALLOW_PRIVATE_HOSTS — optional
#   Optional. Comma-separated host names a destination may point at even though
#   they resolve to private addresses — MinIO next to the stack, a Postgres on the
#   LAN. Every other destination host must resolve to public addresses (SSRF
#   guard).
#   read by: apps/integration-server/src/config.ts
DESTINATIONS_ALLOW_PRIVATE_HOSTS=

# DESTINATIONS_WORKER — optional
#   Optional. Set "off" to stop the destination export scheduler (warehouse/lake
#   exports; manual runs from the admin API still work). Default on whenever the
#   data store is on. See docs/integrate/destinations.md.
#   read by: apps/integration-server/src/config.ts
DESTINATIONS_WORKER=

# DESTINATIONS_WORKER_INTERVAL_MS — optional
#   Optional. How often (ms) the destination scheduler looks for due destinations.
#   Default 30000; each destination still runs at its own interval.
#   read by: apps/integration-server/src/config.ts
DESTINATIONS_WORKER_INTERVAL_MS=

# DOCS_SERVER_INTERNAL_URL — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/admin/src/core/version-info.ts
DOCS_SERVER_INTERNAL_URL=

# DOCS_SERVER_URL — optional
#   Browser-facing URL of docs-server. Used by admin to render cross-app links.
#   read by: apps/admin/src/config.ts
DOCS_SERVER_URL=

# ENV_FILE — optional
#   Dev script only — dotenv file the screenshot automation reads ADMIN_USER /
#   ADMIN_USER_PASSWORD from. Default: the first .env above the script that sets
#   ADMIN_USER (the repo root .env).
#   read by: apps/admin/scripts/screenshots/seed.ts
ENV_FILE=

# EPOSNOW_CLIENT_ID — optional
#   Deprecated. Epos Now OAuth client ID, read only when the eposnow adapter
#   config has no clientId (unset or blank). Set clientId in the adapter config
#   instead; this fallback will be removed. docker-compose.yml does not pass it to
#   integration-server.
#   read by: apps/integration-server/src/verticals/ecommerce/adapters/eposnow/index.ts
EPOSNOW_CLIENT_ID=

# EPOSNOW_CLIENT_SECRET — optional
#   Deprecated. Epos Now OAuth client secret, read only when the eposnow adapter
#   config has no clientSecret (unset or blank). Set clientSecret in the adapter
#   config instead; this fallback will be removed. docker-compose.yml does not
#   pass it to integration-server.
#   read by: apps/integration-server/src/verticals/ecommerce/adapters/eposnow/index.ts
EPOSNOW_CLIENT_SECRET=

# EPOSNOW_REDIRECT_URI — optional
#   Deprecated. Epos Now OAuth redirect URI, read only when the eposnow adapter
#   config has no redirectUri (unset or blank). Set redirectUri in the adapter
#   config instead; this fallback will be removed. docker-compose.yml does not
#   pass it to integration-server.
#   read by: apps/integration-server/src/verticals/ecommerce/adapters/eposnow/index.ts
EPOSNOW_REDIRECT_URI=

# GIT_SHA — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/normalizer-version.ts, packages/shared/src/control-plane/version-router.ts
GIT_SHA=

# HANDLER_TIMEOUT_MS — optional
#   Optional. Ceiling in ms on a whole request handler, after which the caller
#   gets 504 REQUEST_TIMEOUT (an upstream call that times out on its own gives 504
#   UPSTREAM_TIMEOUT). Default 120000 — deliberately larger than one upstream
#   call, because withRetry makes up to five attempts on HTTP 429 with 1+2+4+8s of
#   backoff. This is the outer bound guaranteeing no request hangs indefinitely.
#   read by: apps/integration-server/src/config.ts
HANDLER_TIMEOUT_MS=

# HOST — optional
#   Bind address. Defaults to 0.0.0.0.
#   read by: apps/docs-server/src/index.ts, apps/integration-server/src/config.ts
HOST=

# INTEGRATION_SERVER_URL — optional
#   In-network URL of integration-server.
#   read by: apps/admin-api/src/core/server.ts, apps/admin-api/src/scripts/superset-bootstrap.ts, apps/admin/src/core/version-info.ts, apps/docs-server/src/server.ts (+1 more)
INTEGRATION_SERVER_URL=

# INTEGRATION_URL — optional
#   Dev script only — base URL of integration-server for screenshot automation.
#   read by: apps/admin/scripts/screenshots/run.ts, apps/admin/scripts/screenshots/seed.ts
INTEGRATION_URL=

# JWT_EXPIRES_IN — optional
#   Optional. Lifetime of an admin-api operator session token, as an ms/zeit
#   string (e.g. 12h, 7d). Defaults to 24h. Tokens are stateless, so this is what
#   bounds a leaked one — shorten it if operators sign in from shared machines.
#   read by: apps/admin-api/src/config.ts
JWT_EXPIRES_IN=

# LOGO_SOURCE — optional
#   Optional. none|cdn|local — where platform logos come from. Defaults to none
#   (brand-tinted monogram tiles, no external requests, no account, works
#   air-gapped). cdn hotlinks Brandfetch and needs BRANDFETCH_CLIENT_ID; local
#   serves logos you fetched to docs/platforms/logos. Logos are not shipped with
#   OpenSteward — see docs/operations/platform-logos.md.
#   read by: apps/admin/src/core/routes/logo-config.ts, packages/shared/src/config/logo-source.ts
LOGO_SOURCE=

# NAME — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: scripts/generate-env-example.ts
NAME=

# NODE_ENV — optional
#   production|development|test. Drives strictness of assertSecret + cookie
#   security flags.
#   read by: apps/admin-api/src/core/auth/idp/ldap-provider.ts, apps/admin/src/core/auth/session-cookie.ts, apps/integration-server/src/verticals/logistics/adapters/deliverect/client.ts, packages/shared/src/auth/secrets.ts (+1 more)
NODE_ENV=

# OPENSTEWARD_ADMIN_ORIGIN — optional
#   The admin UI origin(s), comma-separated, allowed to embed Superset: Superset's
#   CSP frame-ancestors and CORS, and the allowed domain of each embedded
#   dashboard. Compose derives it from ADMIN_UI_URL.
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
OPENSTEWARD_ADMIN_ORIGIN=

# OPENSTEWARD_LICENSE — optional
#   Optional. The OpenSteward license itself (a v4.public.… token), for platforms
#   where mounting a file is awkward. Wins over OPENSTEWARD_LICENSE_FILE, which is
#   then ignored (with a warning when that file exists). Read by
#   integration-server only; keep it out of logs and CI output. Empty counts as
#   unset. No license means community mode (1 connection, 1 tenant); the service
#   never refuses to start. See docs/deployment/license.md.
#   read by: apps/integration-server/src/config.ts
OPENSTEWARD_LICENSE=

# OPENSTEWARD_LICENSE_FILE — optional
#   Optional. Path to the license file. Default: license.key next to the
#   credential store (dirname of STORE_PATH); docker-compose sets
#   /etc/opensteward/license/license.key. Mount its DIRECTORY, never the single
#   file (a Kubernetes Secret volume without subPath, a compose bind mount of a
#   folder), so a renewed license is picked up without a restart. It must be
#   readable by uid 1000. Empty counts as unset.
#   read by: apps/integration-server/src/config.ts
OPENSTEWARD_LICENSE_FILE=

# OPENSTEWARD_RELEASE — optional
#   Overrides the release every service reports on /version and the admin's System
#   page shows. Unset, it is read from the VERSION file each image carries (the
#   repo's own, from a checkout). Leave unset unless you repackage the images
#   yourself.
#   read by: packages/shared/src/control-plane/version-router.ts
OPENSTEWARD_RELEASE=

# OST_ALLOW_PRIVATE_HOSTS — optional
#   Dev only. Set to "1" to let safe-fetch reach private IP ranges (e.g. localhost
#   adapters).
#   read by: packages/shared/src/auth/oauth-clients.ts, packages/shared/src/net/safe-fetch.ts
OST_ALLOW_PRIVATE_HOSTS=

# OST_ALLOW_UNAUTH_ADMIN — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: packages/shared/src/control-plane/admin-guard.ts
OST_ALLOW_UNAUTH_ADMIN=

# OST_DISABLE_LOCKOUT — optional
#   Dev only. Set to "1" to bypass admin-api login lockout.
#   read by: apps/admin-api/src/core/auth/lockout.ts
OST_DISABLE_LOCKOUT=

# OST_DOCS_BRANCH — optional
#   Branch used for the same edit-on-GitHub links. Defaults to main.
#   read by: apps/docs-server/src/guides.ts
OST_DOCS_BRANCH=

# OST_DOCS_REPO_URL — optional
#   Public repo URL used by docs-server when rendering "edit on GitHub" links.
#   read by: apps/docs-server/src/guides.ts
OST_DOCS_REPO_URL=

# PORT — optional
#   TCP port the service listens on. Overrides config.yml.
#   read by: apps/docs-server/src/index.ts, apps/integration-server/src/config.ts, scripts/check-secret-passthrough.ts
PORT=

# PR_AUTHOR — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: scripts/check-cla.ts
PR_AUTHOR=

# PUBLIC_BASE_URL — optional
#   Optional canonical public URL of integration-server (overrides company-info
#   baseUrl + Host header).
#   read by: apps/admin/src/core/routes/customers.ts, packages/shared/src/control-plane/public-base-url.ts
PUBLIC_BASE_URL=

# RAPYD_WEBHOOK_URL — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/verticals/payments/adapters/rapyd/webhook.ts
RAPYD_WEBHOOK_URL=

# RATE_LIMIT_MAX — optional
#   Max requests per window. Overrides config.yml.
#   read by: apps/integration-server/src/config.ts, apps/integration-server/src/server.ts, scripts/check-secret-passthrough.ts
RATE_LIMIT_MAX=

# RATE_LIMIT_MCP_END_USER_PER_MIN — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
RATE_LIMIT_MCP_END_USER_PER_MIN=

# RATE_LIMIT_MCP_TENANT_PER_MIN — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
RATE_LIMIT_MCP_TENANT_PER_MIN=

# RATE_LIMIT_WINDOW_MS — optional
#   Rate-limit window in ms.
#   read by: apps/integration-server/src/config.ts, apps/integration-server/src/server.ts
RATE_LIMIT_WINDOW_MS=

# REDIS_URL — optional
#   Optional. Enables shared rate-limit buckets across multiple integration-server
#   replicas.
#   read by: apps/integration-server/src/config.ts
REDIS_URL=

# REFRESH_WORKER_BATCH_DELAY_MS — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_BATCH_DELAY_MS=

# REFRESH_WORKER_BATCH_SIZE — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_BATCH_SIZE=

# REFRESH_WORKER_DEAD_RETRY_MS — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_DEAD_RETRY_MS=

# REFRESH_WORKER_ENABLED — optional
#   Set "false" to disable the background credential-refresh worker.
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_ENABLED=

# REFRESH_WORKER_EXPIRING_WITHIN_MS — optional
#   Renew an access token lapsing within this window. Default 1800000 (30 min).
#   Raise to cut token-endpoint traffic; connections then spend longer showing as
#   expired between uses.
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_EXPIRING_WITHIN_MS=

# REFRESH_WORKER_INTERVAL_MS — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_INTERVAL_MS=

# REFRESH_WORKER_KEEP_WARM_MS — optional
#   How often to exercise a grant that has no access-token expiry. Default
#   72000000 (20h).
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_KEEP_WARM_MS=

# REFRESH_WORKER_SKIP_WINDOW_MS — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/server.ts
REFRESH_WORKER_SKIP_WINDOW_MS=

# SERVICE_SECRET — optional
#   Shared secret sibling services present as X-Service-Secret to read runtime
#   settings from admin-api. Distinct from ADMIN_SECRET, which authenticates the
#   opposite direction. Unset means services cannot read settings and fall back to
#   their own defaults.
#   read by: apps/admin-api/src/core/auth/service-auth.ts, apps/admin-api/src/scripts/superset-bootstrap.ts, apps/docs-server/src/server.ts, apps/integration-server/src/server.ts
SERVICE_SECRET=

# SESSION_COOKIE_SECURE — optional
#   Whether the admin session and flash cookies carry `Secure`. Leave empty: that
#   means NODE_ENV === 'production', which is correct for anything served over
#   HTTPS. Set false ONLY to serve the admin UI over plain HTTP to an address that
#   is not localhost — a browser will not store a Secure cookie there, so login
#   silently bounces back to the login page. It puts a control-plane session token
#   on the wire in cleartext, so prefer HTTPS, or a tunnel that puts the far end
#   back on its own localhost.
#   read by: apps/admin/src/core/auth/session-cookie.ts
SESSION_COOKIE_SECURE=

# SSO_PUBLIC_BASE_URL — optional
#   Public base URL where IdPs send SAML ACS / OIDC callbacks and SCIM hits.
#   read by: apps/admin-api/src/config.ts, apps/admin/src/config.ts
SSO_PUBLIC_BASE_URL=

# STORE_PATH — optional
#   Override path to the integration-server credentials SQLite file. Defaults to
#   ./data/credentials.db.
#   read by: apps/integration-server/scripts/backfill-owner-tenant.ts, apps/integration-server/src/config.ts
STORE_PATH=

# SUPERSET_ANALYTICS_DB_HOST — optional
#   Optional, superset-bootstrap only. Host Superset uses to reach the analytics
#   views (e.g. postgres, or a read replica). Default: the host in DATABASE_URL,
#   else ANALYTICS_READ_HOST.
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_ANALYTICS_DB_HOST=

# SUPERSET_ANALYTICS_DB_NAME — optional
#   Optional, superset-bootstrap only. Database holding the analytics views.
#   Default: the database in DATABASE_URL, else the one integration-server
#   reports.
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_ANALYTICS_DB_NAME=

# SUPERSET_ANALYTICS_DB_PORT — optional
#   Optional, superset-bootstrap only. Port for SUPERSET_ANALYTICS_DB_HOST.
#   Default 5432 (or DATABASE_URL's).
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_ANALYTICS_DB_PORT=

# SUPERSET_ANALYTICS_DB_SSLMODE — optional
#   Optional, superset-bootstrap only. libpq sslmode for Superset's connection to
#   the analytics views (e.g. require).
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_ANALYTICS_DB_SSLMODE=

# SUPERSET_ASSETS_DIR — optional
#   Optional, superset-bootstrap only. Directory of dashboard bundles (*.zip
#   exported from Superset) to import on every run. Default
#   deploy/superset/assets/dashboards.
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_ASSETS_DIR=

# SUPERSET_BOOTSTRAP_TIMEOUT_MS — optional
#   Optional, superset-bootstrap only. How long to wait for Superset to become
#   healthy and the analytics views to be provisioned. Default 600000 (10 min).
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_BOOTSTRAP_TIMEOUT_MS=

# SUPERSET_DB_URI — optional
#   Optional, superset-bootstrap only. A full SQLAlchemy URI
#   (postgresql+psycopg2://…) Superset should use for the analytics views, instead
#   of the read-only SQL principal the job creates and rotates itself. It should
#   still be a masked, read-only login.
#   read by: apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_DB_URI=

# SUPERSET_PUBLIC_URL — optional
#   Optional. Browser-facing Superset URL the admin UI frames dashboards from
#   (iframe src and CSP frame-src), e.g. https://bi.example.com. Defaults to
#   SUPERSET_URL, which is only right when both are the same host.
#   read by: apps/admin-api/src/config.ts
SUPERSET_PUBLIC_URL=

# SUPERSET_SERVICE_PASSWORD — optional
#   Password of the Superset service account (at least 16 characters).
#   scripts/generate-secrets.sh mints one. Must be the same value on admin-api,
#   superset-init and superset-bootstrap.
#   read by: apps/admin-api/src/config.ts, apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_SERVICE_PASSWORD=

# SUPERSET_SERVICE_USERNAME — optional
#   Superset service account admin-api logs in as to mint guest tokens, and the
#   bootstrap job uses to create the database connection, datasets and dashboards.
#   Created by deploy/superset/bootstrap-roles.py. Compose defaults it to
#   opensteward-service.
#   read by: apps/admin-api/src/config.ts, apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_SERVICE_USERNAME=

# SUPERSET_URL — optional
#   Optional. Internal URL admin-api (and the superset-bootstrap job) use to reach
#   Apache Superset, e.g. http://superset:8088. Embedded Superset dashboards are
#   off while this is empty. Postgres deployments only — see
#   docs/deployment/superset.md.
#   read by: apps/admin-api/src/config.ts, apps/admin-api/src/scripts/superset-bootstrap.ts
SUPERSET_URL=

# SYNC_SCHEDULER_INTERVAL_MS — optional
#   Optional. How often (ms) the sync scheduler looks for connections whose sync
#   schedule is due. Default 60000, minimum 5000. The schedules themselves are the
#   data_store.sync.* runtime settings and each connection's own mode.
#   read by: apps/integration-server/src/server.ts
SYNC_SCHEDULER_INTERVAL_MS=

# TEST_DATABASE_URL — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/admin-api/vitest.config.ts, packages/destinations/vitest.config.ts, packages/shared/vitest.config.ts
TEST_DATABASE_URL=

# TRUST_PROXY — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/integration-server/src/config.ts
TRUST_PROXY=

# UPSTREAM_TIMEOUT_MS — optional
#   Optional. Ceiling in ms on a single upstream platform HTTP call. Default
#   30000. Applied as the axios default so it also covers the 592 adapter clients
#   that set no timeout of their own; an adapter with an explicit timeout keeps
#   it. Without this a platform that accepts the connection and goes quiet blocks
#   the request forever.
#   read by: apps/integration-server/src/config.ts
UPSTREAM_TIMEOUT_MS=

# WEBHOOK_GATEWAY_URL — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: apps/admin/src/core/version-info.ts
WEBHOOK_GATEWAY_URL=

# X — optional
#   (no description — add one in scripts/generate-env-example.ts)
#   read by: packages/codegen/src/fetch-logos.ts, packages/shared/src/config/logo-source.ts, scripts/generate-env-example.ts
X=
