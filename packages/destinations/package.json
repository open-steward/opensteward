{
  "name": "@opensteward/destinations",
  "version": "0.1.0",
  "description": "Export the OpenSteward data store to warehouses and lakes (Parquet to S3/GCS/Azure Blob, Postgres)",
  "license": "Elastic-2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/build-stamp.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@azure/storage-blob": "^12.34.0",
    "@databricks/sql": "3.0.0",
    "@google-cloud/bigquery": "9.6.1",
    "@google-cloud/storage": "^9.0.0",
    "@opensteward/shared": "workspace:*",
    "apache-arrow": "^21.2.0",
    "kysely": "^0.29.9",
    "parquet-wasm": "^0.9.0",
    "pg": "^8.23.1",
    "snowflake-sdk": "3.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-sqlite3": "^13.2.0",
    "eslint": "^10.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "author": {
    "name": "Falco Consulting AB"
  },
  "maintainers": [
    {
      "name": "Falco Consulting AB",
      "url": "https://opensteward.dev"
    }
  ]
}
