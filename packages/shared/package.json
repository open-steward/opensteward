{
  "name": "@opensteward/shared",
  "version": "0.1.0",
  "description": "Shared primitives for OpenSteward vertical services",
  "license": "Elastic-2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./db": {
      "import": "./dist/db/index.js",
      "require": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    },
    "./db-copy": {
      "import": "./dist/db-copy/index.js",
      "require": "./dist/db-copy/index.js",
      "types": "./dist/db-copy/index.d.ts"
    },
    "./licensing": {
      "import": "./dist/licensing/index.js",
      "require": "./dist/licensing/index.js",
      "types": "./dist/licensing/index.d.ts"
    },
    "./scripts/backup": {
      "import": "./dist/scripts/backup.js",
      "require": "./dist/scripts/backup.js",
      "types": "./dist/scripts/backup.d.ts"
    },
    "./scripts/restore": {
      "import": "./dist/scripts/restore.js",
      "require": "./dist/scripts/restore.js",
      "types": "./dist/scripts/restore.d.ts"
    },
    "./scripts/doctor": {
      "import": "./dist/scripts/doctor.js",
      "require": "./dist/scripts/doctor.js",
      "types": "./dist/scripts/doctor.d.ts"
    },
    "./scripts/rotate-store-secret": {
      "import": "./dist/scripts/rotate-store-secret.js",
      "require": "./dist/scripts/rotate-store-secret.js",
      "types": "./dist/scripts/rotate-store-secret.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/build-stamp.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@opensteward/license-token": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "js-yaml": "^5.5.0",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "tar": "^7.5.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/tar": "^7.0.0",
    "eslint": "^10.15.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "author": {
    "name": "Falco Consulting AB"
  },
  "maintainers": [
    {
      "name": "Falco Consulting AB",
      "url": "https://opensteward.dev"
    }
  ]
}
