{
  "name": "@opensteward/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for OpenSteward vertical services. Includes admin dashboard, integration server, mcp server, docs server,webhook gateway and shared libraries.",
  "license": "Elastic-2.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:inventory": "tsx scripts/test-inventory.ts",
    "test:pg": "bash scripts/test-pg.sh",
    "dev:admin": "pnpm --filter admin dev",
    "dev:integration-server": "pnpm --filter integration-server dev",
    "dev:oidc-issuer": "tsx scripts/dev-oidc-issuer.ts",
    "license:dev-token": "tsx scripts/license-dev-token.ts",
    "docs:openapi": "pnpm --filter integration-server run generate-openapi",
    "docs:admin-api-openapi": "pnpm --filter admin-api run generate:openapi",
    "check:openapi-examples": "tsx scripts/check-openapi-examples.ts",
    "docs:admin-api-postman": "pnpm --filter admin-api run generate:postman",
    "runtime-settings:generate": "pnpm --filter admin-api run generate:runtime-settings-schema",
    "docs:search-index": "tsx scripts/build-search-index.ts",
    "docs:screenshots": "pnpm --filter admin run docs:screenshots",
    "docs:screenshots:clean": "pnpm --filter admin run docs:screenshots:clean",
    "sdk:generate": "pnpm --filter @opensteward/sdk run generate",
    "cli:generate": "pnpm --filter @opensteward/cli run generate",
    "docs:cli": "pnpm --filter @opensteward/cli run build && tsx packages/cli/scripts/generate-docs.ts",
    "docs:all": "pnpm --filter integration-server run generate:all && pnpm runtime-settings:generate && pnpm docs:admin-api-openapi && pnpm docs:admin-api-postman && pnpm sdk:generate && pnpm cli:generate && pnpm docs:cli && pnpm --filter @opensteward/mcp-server run generate && pnpm generate:read-scopes && pnpm generate:env-example && pnpm docs:search-index",
    "check:cla": "tsx scripts/check-cla.ts",
    "check:guides": "tsx scripts/check-guides.ts",
    "check:webhook-verifiers": "tsx scripts/check-webhook-verifiers.ts",
    "check:webhook-verifiers:soft": "tsx scripts/check-webhook-verifiers.ts --soft",
    "check:adapter-parity": "tsx scripts/check-adapter-parity.ts",
    "check:adapter-parity:soft": "tsx scripts/check-adapter-parity.ts --soft",
    "check:adapter-verification": "tsx scripts/check-adapter-verification.ts",
    "check:adapter-verification:soft": "tsx scripts/check-adapter-verification.ts --soft",
    "check:read-scopes": "tsx scripts/check-read-scopes.ts",
    "check:sandbox-egress": "tsx scripts/check-sandbox-egress.ts",
    "check:sandbox-egress:soft": "tsx scripts/check-sandbox-egress.ts --soft",
    "check:schema-examples": "tsx scripts/check-schema-examples.ts",
    "check:sandbox-coverage": "tsx scripts/check-sandbox-coverage.ts",
    "check:sandbox-coverage:soft": "tsx scripts/check-sandbox-coverage.ts --soft",
    "check:read-scopes:soft": "tsx scripts/check-read-scopes.ts --soft",
    "check:schema-field-casing": "tsx scripts/check-schema-field-casing.ts",
    "check:schema-field-casing:soft": "tsx scripts/check-schema-field-casing.ts --soft",
    "check:collection-null-policy": "tsx scripts/check-collection-null-policy.ts",
    "check:collection-null-policy:soft": "tsx scripts/check-collection-null-policy.ts --soft",
    "check:contact-fk-prefix": "tsx scripts/check-contact-fk-prefix.ts",
    "check:contact-fk-prefix:soft": "tsx scripts/check-contact-fk-prefix.ts --soft",
    "check:transform-tests": "tsx scripts/check-transform-tests.ts",
    "check:transform-tests:soft": "tsx scripts/check-transform-tests.ts --soft",
    "check:transform-schema-assertions": "tsx scripts/check-transform-schema-assertions.ts",
    "check:transform-schema-assertions:soft": "tsx scripts/check-transform-schema-assertions.ts --soft",
    "check:adapter-declarations": "tsx scripts/check-adapter-declarations.ts",
    "check:adapter-declarations:soft": "tsx scripts/check-adapter-declarations.ts --soft",
    "check:clone-signatures": "tsx scripts/check-clone-signatures.ts",
    "check:clone-signatures:soft": "tsx scripts/check-clone-signatures.ts --soft",
    "check:paging-contract": "tsx scripts/check-paging-contract.ts",
    "check:paging-contract:soft": "tsx scripts/check-paging-contract.ts --soft",
    "check:secret-passthrough": "tsx scripts/check-secret-passthrough.ts",
    "check:secret-passthrough:soft": "tsx scripts/check-secret-passthrough.ts --soft",
    "check:server-logging": "tsx scripts/check-server-logging.ts",
    "check:server-logging:soft": "tsx scripts/check-server-logging.ts --soft",
    "check:license-keys": "tsx scripts/check-license-keys.ts",
    "check:license-keys:soft": "tsx scripts/check-license-keys.ts --soft",
    "check:license-keys:release": "tsx scripts/check-license-keys.ts --release",
    "check:warning-gates": "tsx scripts/check-warning-gates.ts",
    "check:warning-gates:soft": "tsx scripts/check-warning-gates.ts --soft",
    "test:warning-gates": "tsx --test scripts/check-warning-gates.test.ts",
    "test:guard-scripts": "tsx --test scripts/check-secret-passthrough.test.ts scripts/check-server-logging.test.ts scripts/check-sandbox-egress.test.ts scripts/check-adapter-declarations.test.ts scripts/check-clone-signatures.test.ts scripts/check-adapter-parity.test.ts scripts/check-money-scaling.test.ts scripts/check-project-references.test.ts scripts/check-docs-fresh.test.ts scripts/check-paging-contract.test.ts scripts/check-override-example.test.ts scripts/check-field-classification.test.ts scripts/check-analytics-catalog.test.ts scripts/build-stamp.test.ts scripts/db-copy-profiles.test.ts scripts/test-pg.test.ts scripts/switch-db.test.ts scripts/license-token-wiring.test.ts scripts/license-turbo-inputs.test.ts scripts/license-dev-token.test.ts scripts/check-published-packages.test.ts scripts/check-license-keys.test.ts scripts/check-license-keys-release.test.ts scripts/image-license-probe.test.ts scripts/compose-license.test.ts scripts/check-no-license-bypass.test.ts scripts/release.test.ts scripts/license-test-matrix.test.ts scripts/marketplace-license.test.ts",
    "test:e2e": "pnpm --filter @opensteward/e2e run test:e2e",
    "smoke:compose": "bash scripts/compose-smoke.sh",
    "scaffold:adapter": "tsx scripts/scaffold-adapter.ts",
    "generate:webhook-aggregators": "tsx scripts/generate-webhook-aggregators.ts accounting crm ecommerce logistics payments docsign projects customer-support inventory",
    "release": "tsx scripts/release.ts",
    "rotate-store-secret": "tsx packages/shared/src/scripts/rotate-store-secret.ts",
    "backup": "tsx packages/shared/src/scripts/backup.ts",
    "restore": "tsx packages/shared/src/scripts/restore.ts",
    "doctor": "tsx packages/shared/src/scripts/doctor.ts",
    "generate:env-example": "tsx scripts/generate-env-example.ts",
    "check:docs": "tsx scripts/check-docs-fresh.ts",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore",
    "generate:read-scopes": "tsx scripts/generate-read-scopes.ts",
    "check:project-references": "tsx scripts/check-project-references.ts",
    "check:project-references:soft": "tsx scripts/check-project-references.ts --soft",
    "check:typecheck-bites": "tsx scripts/check-typecheck-bites.ts",
    "check:typecheck-bites:soft": "tsx scripts/check-typecheck-bites.ts --soft",
    "check:money-scaling": "tsx scripts/check-money-scaling.ts",
    "check:money-scaling:soft": "tsx scripts/check-money-scaling.ts --soft",
    "check:published-packages": "tsx scripts/check-published-packages.ts",
    "check:published-packages:soft": "tsx scripts/check-published-packages.ts --soft",
    "check:field-classification": "tsx scripts/check-field-classification.ts",
    "check:field-classification:soft": "tsx scripts/check-field-classification.ts --soft",
    "check:analytics-catalog": "tsx scripts/check-analytics-catalog.ts",
    "check:no-license-bypass": "tsx scripts/check-no-license-bypass.ts",
    "check:no-license-bypass:soft": "tsx scripts/check-no-license-bypass.ts --soft",
    "check:route-access": "pnpm --filter admin-api exec vitest run tests/unit/route-access.test.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "vite": "^8.3.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "fast-jwt": ">=6.3.4 <7",
      "fast-uri": ">=3.1.9 <4",
      "brace-expansion": ">=5.0.9 <6",
      "qs": ">=6.15.2 <7",
      "hono": ">=4.12.25 <5",
      "find-my-way": ">=9.7.0 <10",
      "ip-address": ">=10.7.4 <11",
      "nanoid": ">=3.3.18 <4",
      "js-yaml@4": ">=4.3.2 <5",
      "vite": ">=8.3.3 <9",
      "esbuild": ">=0.28.1 <0.29",
      "@xmldom/xmldom": ">=0.8.15 <0.9",
      "lodash-es": ">=4.18.0 <5",
      "follow-redirects": ">=1.16.1 <2",
      "basic-ftp": ">=6.2.3 <7",
      "@azure/msal-node": ">=7.1.2 <8"
    }
  },
  "author": {
    "name": "Falco Consulting AB"
  },
  "maintainers": [
    {
      "name": "Falco Consulting AB",
      "url": "https://opensteward.dev"
    }
  ]
}
